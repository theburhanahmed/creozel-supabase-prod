# ─── Supabase (self-hosted via Kong on port 8000) ────────────────────────────
# Copy this file to .env and fill in the values from your repo root .env

# The Kong gateway URL — this is your local Supabase API entry point
VITE_SUPABASE_URL=http://localhost:8000

# The ANON_KEY from your repo root .env (ANON_KEY variable)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Optional: Stripe public key for billing UI ───────────────────────────────
VITE_STRIPE_PUBLIC_KEY=

# ─── Optional: Razorpay key for India billing ─────────────────────────────────
VITE_RAZORPAY_KEY_ID=
