VAULT_ENC_KEY=your-encryption-key-32-chars-min


############
# Database - You can change these to any PostgreSQL database that has logical replication enabled.
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres # default user is postgres


############
# Supavisor -- Database pooler
############
# Port Supavisor listens on for transaction pooling connections
POOLER_PROXY_PORT_TRANSACTION=6543
# Maximum number of PostgreSQL connections Supavisor opens per pool
POOLER_DEFAULT_POOL_SIZE=20
# Maximum number of client connections Supavisor accepts per pool
POOLER_MAX_CLIENT_CONN=100
# Unique tenant identifier
POOLER_TENANT_ID=supastar
# Pool size for internal metadata storage used by Supavisor
# This is separate from client connections and used only by Supavisor itself
POOLER_DB_POOL_SIZE=5


############
# API Proxy - Configuration for the Kong Reverse proxy.
############

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443


############
# API - Configuration for PostgREST.
############

PGRST_DB_SCHEMAS=public,storage,graphql_public,n8n


############
# Auth - Configuration for the GoTrue authentication server.
############

## General
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
API_EXTERNAL_URL=http://localhost:8000

## Mailer Config
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

## Email auth
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
ENABLE_ANONYMOUS_USERS=false

## Password policy (GoTrue enforces minimum length; complexity is validated client-side)
GOTRUE_PASSWORD_MIN_LENGTH=8

## Rate limiting for GoTrue auth endpoints (adjust per environment)
GOTRUE_RATE_LIMIT_EMAIL_SENT=5/1h
GOTRUE_RATE_LIMIT_TOKEN_REFRESH=150

## Phone auth
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true


############
# Studio - Configuration for the Dashboard
############

STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project

STUDIO_PORT=3000
# replace if you intend to use Studio outside of localhost
SUPABASE_PUBLIC_URL=http://localhost:8000

# Enable webp support
IMGPROXY_ENABLE_WEBP_DETECTION=true

# Add your OpenAI API key to enable SQL Editor Assistant
OPENAI_API_KEY=


############
# Functions - Configuration for Functions
############
# NOTE: VERIFY_JWT applies to all functions. Per-function VERIFY_JWT is not supported yet.
FUNCTIONS_VERIFY_JWT=false


############
# Logs - Configuration for Analytics
# Please refer to https://supabase.com/docs/reference/self-hosting-analytics/introduction
############

# Change vector.toml sinks to reflect this change
# these cannot be the same value
LOGFLARE_PUBLIC_ACCESS_TOKEN=your-super-secret-and-long-logflare-key-public
LOGFLARE_PRIVATE_ACCESS_TOKEN=your-super-secret-and-long-logflare-key-private

# Docker socket location - this value will differ depending on your OS
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# Google Cloud Project details
GOOGLE_PROJECT_ID=GOOGLE_PROJECT_ID
GOOGLE_PROJECT_NUMBER=GOOGLE_PROJECT_NUMBER


############
# n8n - Configuration for self-hosted instance
############
N8N_ENCRYPTION_KEY=super-secret-key
N8N_USER_MANAGEMENT_JWT_SECRET=even-more-secret
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

############
# Ollama - Configuration for local AI inference
############

# Ollama service configuration
OLLAMA_HOST=0.0.0.0
OLLAMA_ORIGINS=*
OLLAMA_BASE_URL=http://ollama:11434

# Default models to pull (optional - can be pulled manually)
OLLAMA_DEFAULT_MODELS=llama3.2:1b,nomic-embed-text

############
# AI Provider Keys (used by Edge Functions)
############
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=

############
# Stripe / Razorpay (billing)
############
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

############
# Dodo Payments
# Docs: https://docs.dodopayments.com
############

# Server-side API key from the Dodo Payments dashboard.
# Use a test key (sk_test_...) for test_mode and a live key (sk_live_...) for live_mode.
DODO_PAYMENTS_API_KEY=

# HMAC webhook secret from the Dodo Payments dashboard (Webhooks → Signing Secret).
# Used by the dodo-webhook Edge Function to verify incoming webhook signatures
# via the Standard Webhooks spec (standardwebhooks.com).
DODO_PAYMENTS_WEBHOOK_KEY=

# Payment environment: "test_mode" routes to https://test.dodopayments.com (no real charges);
# "live_mode" routes to https://live.dodopayments.com (real charges apply).
# ⚠️  This value MUST match VITE_DODO_PAYMENTS_ENVIRONMENT below.
#     A mismatch causes the create-checkout Edge Function to return HTTP 500
#     and reject all checkout requests until both values are aligned.
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Set to "true" to enable the Dodo Payments UI in AddCredits.tsx.
# When absent or any value other than "true", all purchase buttons are disabled
# and a non-dismissible configuration warning is shown in the page body.
VITE_DODO_PAYMENTS_ENABLED=true

# Client-side environment indicator consumed by Vite.
# Must match DODO_PAYMENTS_ENVIRONMENT exactly ("test_mode" or "live_mode").
# When set to "test_mode", the AddCredits page shows a yellow "Sandbox Mode" badge
# and a "Test: Add 100 Credits" button for manual testing without a real checkout.
VITE_DODO_PAYMENTS_ENVIRONMENT=test_mode
